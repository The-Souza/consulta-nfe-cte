# Ambiente virtual Python
.venv/

# Cache do Python
__pycache__/
*.pyc
*.pyo

# Credenciais salvas localmente (contém e-mail do usuário), inclusive o temporário da gravação
config.json*

# Variáveis de ambiente (contém URLs e dados internos da empresa)
.env

# Utilitário "Enviar planilha": chave secreta do Supabase e preferências locais
enviar_planilha.env
enviar_planilha.json

# Arquivos de saída gerados pelo script e planilhas com dados reais
*.xlsx
*.csv

# PyInstaller
dist/
build/
*.spec

# claude
.claude
claude*

# Ícones (podem conter marca da empresa)
*.ico

# Arquivos de documentação (podem conter informações internas da empresa)
/docs/
