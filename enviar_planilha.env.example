# Configuração do utilitário "Enviar planilha".
# Copie para enviar_planilha.env, ao lado do enviar-planilha.exe ou na raiz do projeto.
# Este arquivo NÃO é o .env do app: a chave secreta nunca vai para o .env do app nem para o git.

# URL do projeto Supabase (Project Settings > API)
SUPABASE_URL=

# Chave secreta (sb_secret_...), a única que pode gravar na tabela entregas
SUPABASE_SECRET_KEY=

# Planilha aberta por padrão na primeira vez (opcional).
# Cole o caminho SEM aspas: entre aspas duplas, trechos como \a, \b e \t do caminho viram outros caracteres.
# Exemplo: PLANILHA_PATH=C:\Planilhas\entregas.xlsx
PLANILHA_PATH=
